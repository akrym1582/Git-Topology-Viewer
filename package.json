{
  "name": "git-topology-viewer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.4.2",
  "publisher": "ymknr1582",
  "icon": "resources/topology.png",
  "galleryBanner": {
    "color": "#1f6feb",
    "theme": "dark"
  },
  "keywords": [
    "Git",
    "branch",
    "commit",
    "graph",
    "merge",
    "topology"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/akrym1582/Git-Topology-Viewer.git"
  },
  "bugs": {
    "url": "https://github.com/akrym1582/Git-Topology-Viewer/issues"
  },
  "homepage": "https://github.com/akrym1582/Git-Topology-Viewer#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gitTopology.open"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "gitTopology.open",
        "title": "%command.open%",
        "category": "%configuration.title%",
        "icon": "$(graph)"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "gitTopology.gitPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.gitPath.description%"
        },
        "gitTopology.maxCommits": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "description": "%configuration.maxCommits.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icon:generate": "node scripts/generate-icon.mjs",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies",
    "package:check": "npm run build && npx --yes @vscode/vsce ls --no-dependencies",
    "screenshots:refresh": "npm run build && node test/smoke/webview-smoke.mjs",
    "smoke:webview": "npm run screenshots:refresh",
    "smoke:install": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.55.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
