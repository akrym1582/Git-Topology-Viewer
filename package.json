{
  "name": "git-topology-viewer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.1",
  "publisher": "git-topology",
  "repository": {
    "type": "git",
    "url": "https://github.com/akrym1582/Git-Topology-Viewer.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gitTopology.open"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "gitTopology.open",
        "title": "%command.open%",
        "category": "%configuration.title%",
        "icon": "$(graph)"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "gitTopology.gitPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.gitPath.description%"
        },
        "gitTopology.maxCommits": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "description": "%configuration.maxCommits.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:webview": "npm run build && node test/smoke/webview-smoke.mjs",
    "smoke:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
